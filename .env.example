# Required
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional tuning
OVERSEER_POLL_INTERVAL=10   # seconds between supervisor polls
OVERSEER_WINDOW=15          # actions to analyze per agent
OVERSEER_MIN_ACTIONS=4      # min actions before analysis starts
OVERSEER_CONFIDENCE=0.78    # intervention confidence threshold
OVERSEER_PORT=7860          # dashboard port
